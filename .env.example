# Copy to .env and edit. Never commit .env.

# "mock" runs fully offline (no API key). "gemini" uses a real vision LLM + LLM planner.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Decision thresholds - tune with `python -m eval.run_eval`, don't guess.
APPROVE_THRESHOLD=0.85
PICKUP_THRESHOLD=0.50
AUTO_APPROVE_MAX_PRICE=5000
